# Copy this file to .env and fill in LOCAL-ONLY values.
# Never put live/production credentials, API keys, or salts from the real site in here.

# --- WordPress / Bedrock ---
WP_ENV=development
WP_HOME=http://localhost:8088
WP_SITEURL=${WP_HOME}/wp

# --- Database (MariaDB) ---
DB_NAME=dermadirect_local
DB_USER=dermadirect
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-root-local-only
DB_PREFIX=wp_

# --- WordPress salts ---
# Generate fresh LOCAL-ONLY values, e.g. one `openssl rand -base64 64` per line below.
# Do not reuse the live site's salts.
AUTH_KEY='generate-a-local-only-value'
SECURE_AUTH_KEY='generate-a-local-only-value'
LOGGED_IN_KEY='generate-a-local-only-value'
NONCE_KEY='generate-a-local-only-value'
AUTH_SALT='generate-a-local-only-value'
SECURE_AUTH_SALT='generate-a-local-only-value'
LOGGED_IN_SALT='generate-a-local-only-value'
NONCE_SALT='generate-a-local-only-value'

# --- Mail (Mailpit — a local SMTP catch-all; nothing is ever sent externally) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=local@dermadirect.test
SMTP_FROM_NAME="DermaDirect Local"

# --- Local safety switches (enforced by local/mu-plugins/000-local-safety.php) ---
DISABLE_WP_CRON=true
ACTION_SCHEDULER_DISABLE_CLOCK=true
BLOCK_EXTERNAL_HTTP=true

# --- Migration safety harness allow-list (web/app/mu-plugins/dd-migration-safety.php) ---
# Non-production only. Hosts that may be reached over https despite the outbound HTTP block,
# comma or space separated, exact host match (no wildcards). Leave empty to block everything.
# See docs/print-pick-runbook.md before setting this.
DD_SAFETY_ALLOW_HOSTS=

# --- Packing slip print overrides (non-production only, off unless set to true) ---
# Auto-print every order on Ship, not only review checkout orders.
# DD_PACKING_SLIP_PRINT_ALL_ORDERS=true
# WARNING: makes this non-production site print to the real warehouse printers.
# DD_PACKING_SLIP_ALLOW_PRODUCTION_PRINTERS=true

# --- TEST marking on printed documents (web/app/mu-plugins/dd-test-print-marker.php) ---
# Non-production sites mark every printed document "TEST ORDER - DO NOT PICK OR SHIP" unless this
# is false/0/off/no. Production is never marked. WARNING: keep this unset on 2.0. Turning it off
# sends unmarked documents to the warehouse printers.
# DD_PRINT_TEST_BANNER=false

# --- Ports (bound to 127.0.0.1 only — never exposed on the network) ---
WEB_PORT=8088
MAILPIT_UI_PORT=18025
DB_PORT=3306

# --- Theme build (used by the `node` deps-profile service) ---
THEME_PATH=web/app/themes/derma-direct
